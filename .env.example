# Only use these synthetic values on a local development machine.
# Copy this file to .env for local overrides; never commit a real credential.
POSTGRES_USER=nexus_local
POSTGRES_PASSWORD=nexus_local_password
POSTGRES_DB=nexus_local
POSTGRES_PORT=15432
REDIS_PORT=16379
DATABASE_URL=postgresql://nexus_local:nexus_local_password@127.0.0.1:15432/nexus_local
REDIS_URL=redis://127.0.0.1:16379
